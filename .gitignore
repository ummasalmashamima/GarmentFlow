# React frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Shared local configuration and generated output
.env
.env.*
!.env.example
*.log
.DS_Store
.phpunit.result.cache
